digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Cli Options: accounts households catalog trips --no-inheritance --exclude-models Abstract*,OrderedModelBase

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
    shape = "plaintext"
  ]

  edge [
    fontname = "Roboto"
    fontsize = 8
  ]

  // Labels


